# Default: public 2GIS cards through local Playwright Chromium.
TWOGIS_PROVIDER=playwright
# Optional: required only when TWOGIS_PROVIDER=api.
TWOGIS_API_KEY=
# Optional server port.
PORT=3000
# Optional local Ollama host. Jarvis uses the first reachable host and an installed local model.
# OLLAMA_HOST=http://127.0.0.1:11434
# Upper bound for the "all available" option.
TWOGIS_MAX_RESULTS=500
